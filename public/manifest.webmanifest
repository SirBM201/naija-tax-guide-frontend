{
  "name": "Naija Tax Guide",
  "short_name": "NaijaTax",
  "description": "Nigeria-focused AI tax guidance for individuals, freelancers, creators, and SMEs.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#050816",
  "theme_color": "#050816",
  "categories": ["business", "finance", "productivity", "education"],
  "lang": "en-NG",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/ntg-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/ntg-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/bms-logo.jpg",
      "sizes": "192x192 512x512",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Dashboard",
      "short_name": "Dashboard",
      "description": "Open your Naija Tax Guide workspace.",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/icons/ntg-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Pricing",
      "short_name": "Pricing",
      "description": "View Naija Tax Guide plans and pricing.",
      "url": "/pricing?source=pwa-shortcut",
      "icons": [{ "src": "/icons/ntg-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
